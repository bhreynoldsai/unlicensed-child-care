# Unlicensed Care — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local, and never paste
# real keys into chat or a document (Doc 02 §8).

# --- Database (required) ---------------------------------------------------
# Local:  postgres://postgres:postgres@localhost:5432/unlicensed_care
# Hosted: connection string from Neon / Supabase / Vercel Postgres / RDS
DATABASE_URL=

# Set to "false" only for a local Postgres without TLS.
DATABASE_SSL=true

# --- Geocoding -------------------------------------------------------------
# The U.S. Census geocoder needs no key. These override its defaults.
CENSUS_BENCHMARK=Public_AR_Current
CENSUS_VINTAGE=Current_Current

# Commercial fallback for addresses Census cannot resolve (Google or Mapbox).
# Leave blank until a provider is chosen — the app fails soft without it.
GEOCODER_FALLBACK_KEY=

# --- Email sending ---------------------------------------------------------
# Resend API key, and the verified sending identity on a domain you control.
# A gmail.com from-address cannot be DKIM-signed and will be filtered.
#   EMAIL_FROM_ADDRESS="Georgia Licensed Child Care Network <info@galicensedcare.org>"
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Where replies land — the channel supporters use to report a wrong district.
EMAIL_REPLY_TO=
# CAN-SPAM requires a real physical postal address in every email footer.
EMAIL_FOOTER_POSTAL_ADDRESS=

# --- SMS sending (Phase 1+) ------------------------------------------------
# Twilio or equivalent. STOP/HELP handling must be enabled at the provider.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# --- Public site URL -------------------------------------------------------
# Drives the share link on the confirmation screen and the QR code on the
# break room poster. Set this BEFORE printing any posters.
NEXT_PUBLIC_SITE_URL=https://galicensedcare.org

# Set to "false" to hide the aggregate "providers in N districts" line.
# Aggregate framing only — never individual-level social proof (Doc 03 §4).
NEXT_PUBLIC_SHOW_AGGREGATE_STAT=true

# --- Admin auth (required for /admin; the route 503s without all three) -----
# Comma-separated. An administrator signs in with their own email — that is
# what export_audit.admin_email records — and the shared password below.
ADMIN_ALLOWED_EMAILS=
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Generate with: openssl rand -base64 24 — rotate when anyone leaves the team.
ADMIN_PASSWORD=

# --- Bot protection (Cloudflare Turnstile) ---------------------------------
# Free, no account cost beyond a Cloudflare login. With no secret key set,
# verification is SKIPPED — fine locally, unacceptable in production.
# Cloudflare's test keys: site 1x00000000000000000000AA / secret
# 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sponsor identity (CAN-SPAM disclosure block) ---------------------------
# Public-facing coalition name shown in the footer and on the privacy notice.
NEXT_PUBLIC_SPONSOR_NAME=Georgia Licensed Child Care Network
# Only set this if the entity that PAYS differs from the name above — the
# "Paid for by" line must identify who actually funded the effort.
NEXT_PUBLIC_SPONSOR_PAID_FOR_BY=
# Physical postal address. Legally required; `npm run preflight` fails without it.
NEXT_PUBLIC_SPONSOR_POSTAL_ADDRESS=

# Where supporters report a wrong legislator match, and the privacy contact.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- SMS consent visibility ---------------------------------------------------
# The SMS consent checkbox is HIDDEN unless this is exactly "true". Its text
# promises "Reply STOP to cancel", so it must not be shown until a Twilio A2P
# 10DLC campaign is approved and Advanced Opt-Out is enabled. Everything behind
# it (schema, consent language, sms consent_events channel) stays in place.
NEXT_PUBLIC_SHOW_SMS_CONSENT=
