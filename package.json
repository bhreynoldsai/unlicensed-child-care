{
  "name": "unlicensed-care-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Grassroots activation platform for the licensed child care community (True North Strategies)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "districts:rematch": "node --env-file-if-exists=.env.local scripts/rematch-districts.mjs",
    "legislators:import": "node --env-file-if-exists=.env.local scripts/import-legislators.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs"
  },
  "dependencies": {
    "next": "15.1.6",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
